# Plans: from an answers file or from the interview
# --------------------------------------------------------------------------

def catalog_role(name, level=None):
    role = dict(ROLES[name])
    role["name"] = name
    role["level"] = level or role["level"]
    role["knows"] = []
    return role


def custom_role(entry):
    if not isinstance(entry, dict):
        raise UsageError("custom_roles entries must be objects")
    name = (str_field(entry.get("name"), "custom role name") or "").strip()
    if not ROLE_NAME_RE.match(name):
        raise UsageError("bad custom role name %r (lowercase letters, digits, hyphens)" % name)
    level = (str_field(entry.get("level"), "level of " + name) or "mid").strip()
    if level not in LEVEL_MODEL:
        raise UsageError("bad level %r for %s (senior, mid or junior)" % (level, name))
    line = sentence(str_field(entry.get("description"), "description of " + name) or "")
    if not line:
        raise UsageError("custom role %s needs a description" % name)
    return {"name": name, "level": level, "line": line, "rules": [], "tools": None,
            "knows": split_list(entry.get("knows"), "knows of " + name)}


def finish_plan(plan):
    names = [r["name"] for r in plan["roles"]]
    dupes = sorted(set(n for n in names if names.count(n) > 1))
    if dupes:
        raise UsageError("role named twice: " + ", ".join(dupes))
    if not plan["roles"]:
        raise Abort("no roles chosen, nothing to do")
    return plan


def plan_from_answers(path, detected):
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except OSError as exc:
        raise UsageError("cannot read answers file: %s" % exc)
    except ValueError as exc:
        raise UsageError("answers file is not valid JSON: %s" % exc)
    if not isinstance(data, dict):
        raise UsageError("answers file must be a JSON object")

    kind = str_field(data.get("kind", detected["kind"]), "kind")
    if kind not in KIND_ROLES:
        raise UsageError("unknown kind %r (known: %s)" % (kind, ", ".join(KINDS)))
    description = sentence(str_field(data.get("description", detected["description"]), "description") or "")
    if not description:
        raise UsageError("answers need a description (none in the file, none found in README.md)")
    test_command = str_field(data.get("test_command", detected["test_command"]), "test_command")
    test_command = (test_command or "").strip() or None
    if test_command and test_command.lower() == "none":
        test_command = None

    role_names = data.get("roles")
    role_names = KIND_ROLES[kind] if role_names is None else split_list(role_names, "roles")
    addons = split_list(data.get("addons"), "addons")
    for n in role_names:
        if n not in ROLES:
            raise UsageError("unknown role %r (see claude-stuffer --kinds)" % n)
    for n in addons:
        if n not in ADDONS:
            raise UsageError("unknown add-on %r (known: %s)" % (n, ", ".join(ADDONS)))

    roles = [catalog_role(n) for n in role_names]
    roles += [catalog_role(n) for n in addons if n not in role_names]
    customs = data.get("custom_roles") or []
    if not isinstance(customs, list):
        raise UsageError("custom_roles must be a list")
    roles += [custom_role(c) for c in customs]
    production = data.get("production", detected["production"])
    if not isinstance(production, bool):
        raise UsageError("production must be true or false, not %s" % json.dumps(production))

    plan = {
        "name": sentence(str_field(data.get("name"), "name") or detected["name"]),
        "description": description,
        "kind": kind,
        "languages": split_list(data.get("languages", detected["languages"]), "languages"),
        "test_command": test_command,
        "production": production,
        "docs": split_list(data.get("docs", detected["docs"]), "docs"),
        "roles": roles,
    }
    return finish_plan(plan)


class Prompter:
    """Line-by-line questions on stdin/stdout. At end of input every answer is its default,
    except the final confirmation, which then means no."""

    def __init__(self):
        self.eof = False
        self.tty = sys.stdin.isatty()

    def read(self, prompt):
        if self.eof:
            print(prompt)
            return ""
        try:
            line = input(prompt)
        except EOFError:
            self.eof = True
            print()
            return ""
        if not self.tty:
            print(line.strip())  # echo piped answers so the transcript reads like a session
        return line.strip()

    def ask(self, question, default=""):
        shown = " [%s]" % default if default else ""
        return self.read("%s%s: " % (question, shown)) or default

    def yes(self, question, default, eof_means_no=False):
        """y/n question. With eof_means_no, end of input aborts instead of taking the default."""
        hint = "[Y/n]" if default else "[y/N]"
        while True:
            answer = self.read("%s %s " % (question, hint)).lower()
            if self.eof and eof_means_no:
                raise Abort("no confirmation (end of input), nothing written")
            if not answer:
                return default
            if answer in ("y", "yes"):
                return True
            if answer in ("n", "no"):
                return False
            print("  please answer y or n")


def interview(detected, io):
    print("claude-stuffer %s: staffing a project. Enter accepts the default in brackets.\n" % VERSION)
    name = io.ask("Project name", detected["name"])

    description = ""
    while not description:
        description = sentence(io.ask("What is it, in one line", detected["description"]))
        if not description:
            if io.eof:
                raise UsageError("a one-line description is required")
            print("  a one-line description is required")

    print("Kinds:")
    for i, kind in enumerate(KINDS, 1):
        print("  %2d. %-8s %s" % (i, kind, ", ".join(KIND_ROLES[kind]) or "(custom roles only)"))
    while True:
        answer = io.ask("Kind", detected["kind"])
        if answer.isdigit() and 1 <= int(answer) <= len(KINDS):
            kind = KINDS[int(answer) - 1]
            break
        if answer in KIND_ROLES:
            kind = answer
            break
        print("  pick a number or a kind name")

    languages = io.ask("Languages/frameworks, comma separated", ", ".join(detected["languages"]))
    languages = [] if languages.lower() == "none" else split_list(languages)

    test_command = io.ask('Test command ("none" if there is no test suite)', detected["test_command"] or "none")
    if test_command.lower() == "none":
        test_command = None
        print(NO_TESTS_NOTICE)

    production = io.yes("Touches production systems (servers, cron, live databases)?",
                        detected["production"])
    docs = io.ask("Documents a role must read first, comma separated", ", ".join(detected["docs"]))
    docs = [] if docs.lower() == "none" else split_list(docs)

    roles = []
    for role_name in KIND_ROLES[kind]:
        role = catalog_role(role_name)
        if io.yes("Keep %s (%s): %s?" % (role_name, role["level"], role["line"]), True):
            roles.append(role)

    offered = []
    if production and "site-ops" not in KIND_ROLES[kind]:
        offered.append("site-ops")
    if production or SECURITY_WORDS.search(description + " " + " ".join(languages)):
        offered.append("security-reviewer")
    for addon in offered:
        role = catalog_role(addon)
        if io.yes("Add %s (%s): %s?" % (addon, role["level"], role["line"]), False):
            roles.append(role)

    print("Custom roles (blank name to finish).")
    taken = set(r["name"] for r in roles)
    while True:
        role_name = io.ask("  Role name (lowercase, hyphens)")
        if not role_name:
            break
        if not ROLE_NAME_RE.match(role_name) or role_name in taken:
            print("  use 2-41 characters: lowercase letters, digits, hyphens; not a name already chosen")
            continue
        line = ""
        while not line:
            line = sentence(io.ask("  What it does (one line)"))
            if not line and io.eof:
                raise UsageError("custom role %s needs a description" % role_name)
        knows = split_list(io.ask("  What it must know (comma-separated paths or notes)"))
        while True:
            level = io.ask("  Level (senior, mid, junior)", "mid")
            if level in LEVEL_MODEL:
                break
            print("  senior, mid or junior")
        roles.append({"name": role_name, "level": level, "line": line, "rules": [], "tools": None,
                      "knows": knows})
        taken.add(role_name)

    return finish_plan({"name": name, "description": description, "kind": kind,
                        "languages": languages, "test_command": test_command,
                        "production": production, "docs": docs, "roles": roles})


