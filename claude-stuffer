def staff_actions(project, plan, force):
    agents = os.path.join(project, ".claude", "agents")
    actions = [plan_file(os.path.join(agents, r["name"] + ".md"), render_agent(plan, r), force)
               for r in plan["roles"]]
    actions.append(claude_md_action(os.path.join(project, "CLAUDE.md"), "# " + plan["name"],
                                    TEAM_START, TEAM_END, render_team_block(plan)))
    chosen = set(r["name"] + ".md" for r in plan["roles"])
    leftovers = []
    if os.path.isdir(agents):
        for f in sorted(os.listdir(agents)):
            path = os.path.join(agents, f)
            if f.endswith(".md") and f not in chosen and is_ours(path):
                leftovers.append(path)
    return actions, leftovers


def warn_if_no_bench():
    agents = os.path.join(stuffer_home(), ".claude", "agents")
    missing = [n for n in BENCH_NAMES if not os.path.isfile(os.path.join(agents, n + ".md"))]
    if missing:
        sys.stderr.write("warning: the global bench is missing in %s (%s); run `claude-stuffer init`\n"
                         % (agents, ", ".join(missing)))


def cmd_staff(args):
    project = os.path.abspath(args.project or os.getcwd())
    if not os.path.isdir(project):
        raise UsageError("no such folder: %s" % project)
    detected = detect(project)
    if args.answers:
        plan = plan_from_answers(args.answers, detected)
        io = None
    else:
        warn_if_no_bench()
        io = Prompter()
        plan = interview(detected, io)

    actions, leftovers = staff_actions(project, plan, args.force)
    if args.dry_run or io is not None:
        print("\nFiles for %s (%s):" % (plan["name"], ", ".join(r["name"] for r in plan["roles"])))
        print(describe(actions, dry_run=True))
    if args.dry_run:
        if leftovers:
            print("remove by hand: " + " ".join(display_path(p) for p in leftovers))
        print("Dry run: nothing written.")
        return EXIT_OK
    if io is not None and not io.yes("Write these files?", True, eof_means_no=True):
        raise Abort("nothing written")

    apply(actions)
    print("Staffed %s:" % plan["name"])
    print(describe(actions, dry_run=False))
    if leftovers:
        print("remove by hand: " + " ".join(display_path(p) for p in leftovers))
    print("Check with /agents in a new session.")
    return EXIT_OK


def cmd_init(args):
    claude = os.path.join(stuffer_home(), ".claude")
    agents = os.path.join(claude, "agents")
    actions = [plan_file(os.path.join(agents, n + ".md"), bench_text(n), args.force) for n in BENCH_NAMES]
    actions.append(claude_md_action(os.path.join(claude, "CLAUDE.md"), "# Global instructions",
                                    RULES_START, RULES_END, RULES))
    print(describe(actions, dry_run=args.dry_run))
    if args.dry_run:
        print("Dry run: nothing written.")
        return EXIT_OK
    apply(actions)
    print(INIT_HINT)
    return EXIT_OK


def parse_frontmatter(text):
    m = re.match(r"---\n(.*?)\n---\n", text, re.S)
    out = {}
    if m:
        for line in m.group(1).splitlines():
            key, _, value = line.partition(":")
            out[key.strip()] = value.strip()
    return out


def show_line(description, ours):
    """The role's own one-liner: after the `architect). ` prefix for our files, else the first sentence."""
    prefix = "architect). "
    if ours and prefix in description:
        return description.split(prefix, 1)[1]
    return re.split(r"(?<=[.!?])\s", description, maxsplit=1)[0]


def cmd_show(args):
    project = os.path.abspath(args.project or os.getcwd())
    agents = os.path.join(project, ".claude", "agents")
    files = sorted(f for f in os.listdir(agents) if f.endswith(".md")) if os.path.isdir(agents) else []
    if not files:
        raise Abort("no team here, run claude-stuffer")
    rows = [("name", "model", "level", "description", "generated")]
    for f in files:
        text = read_text(os.path.join(agents, f))
        fm = parse_frontmatter(text)
        model = fm.get("model", "?")
        ours = is_ours(os.path.join(agents, f))
        rows.append((fm.get("name", f[:-3]), model, MODEL_LEVEL.get(model, "?"),
                     show_line(fm.get("description", ""), ours), "yes" if ours else "no"))
    widths = [max(len(r[i]) for r in rows) for i in range(4)]
    for r in rows:
        print("  ".join(r[i].ljust(widths[i]) for i in range(4)) + "  " + r[4])
    return EXIT_OK


def print_kinds():
    for kind in KINDS:
        roles = ", ".join("%s (%s)" % (n, ROLES[n]["level"]) for n in KIND_ROLES[kind])
        print("%-8s %s" % (kind, roles or "no proposed roles; custom only"))
    print("add-ons   " + ", ".join("%s (%s)" % (n, ROLES[n]["level"]) for n in ADDONS))
    return EXIT_OK


