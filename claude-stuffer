def detect_languages(files):
    return [lang for lang, patterns in LANGUAGE_RULES if _any(files, *patterns)]


def detect_test_command(root, files):
    top = set(f for f in files if "/" not in f)
    if "go.mod" in top:
        return "go test ./..."
    if "pubspec.yaml" in top:
        return "flutter test"
    if "package.json" in top:
        test = (_load_json(os.path.join(root, "package.json")).get("scripts") or {}).get("test")
        if test and "no test specified" not in str(test):
            return "npm test"
    for folder in ("tests", "test"):
        if any(fnmatch.fnmatch(f, folder + "/*.bats") for f in files):
            return "bats " + folder
    for make in ("Makefile", "makefile"):
        if make in top and re.search(r"^test\s*:", read_text(os.path.join(root, make)), re.M):
            return "make test"
    if ("pytest.ini" in top or "pyproject.toml" in top
            or any(fnmatch.fnmatch(f, "tests/*.py") for f in files)
            or _any(files, "test_*.py")):
        return "pytest"
    return None


def detect_kind(root, files, dirs):
    top = set(f for f in files if "/" not in f)
    top_dirs = set(d for d in dirs if "/" not in d)
    dir_names = set(_base(d) for d in dirs)
    has_main = _any(files, "main.go", "cli.py", "__main__.py")

    if _any(files, "project.godot") or dir_names & {"godot", "genres", "games"}:
        return "game"
    if _any(files, "pubspec.yaml") or {"android", "ios"} <= top_dirs:
        return "mobile"
    if (_any(files, "docker-compose*.yml", "docker-compose*.yaml", "Caddyfile", "nginx*.conf")
            or top_dirs & {"ops", "deploy"}):
        return "infra"
    if "package.json" in top:
        pkg = _load_json(os.path.join(root, "package.json"))
        deps = {}
        for key in ("dependencies", "devDependencies", "peerDependencies"):
            deps.update(pkg.get(key) or {})
        if set(deps) & {"react", "vue", "svelte"}:
            return "web"
    if _any(files, "index.html") and _any(files, "*.css"):
        return "web"
    if sum(1 for f in files if f.endswith(".sql")) >= 3 or top_dirs & {"data", "etl"}:
        return "data"
    if ("go.mod" in top or "pyproject.toml" in top) and has_main:
        return "cli"
    if (("setup.py" in top or "pyproject.toml" in top) and not has_main) or \
            ("lib" in top_dirs and "go.mod" in top):
        return "library"
    rest = [f for f in files if f not in ("README.md", "CLAUDE.md")]
    if rest and sum(1 for f in rest if f.lower().endswith(".md")) * 2 > len(rest):
        return "content"
    return "other"


def detect_docs(files):
    found = [f for f in ("README.md", "CLAUDE.md") if f in files]
    in_docs = sorted((f for f in files if f.startswith("docs/") and f.endswith(".md")),
                     key=lambda f: (f.count("/"), f))
    patterns = ["*style*guide*.md", "*conventions*.md", "*architecture*.md"]
    named = [f for f in files if any(fnmatch.fnmatch(_base(f).lower(), p) for p in patterns)]
    for f in in_docs + named:
        if f not in found:
            found.append(f)
    return found[:8]


def detect_production(root, files):
    for f in files:
        base = _base(f)
        if (f.startswith("ops/") or f.startswith("deploy/") or base == "Caddyfile"
                or fnmatch.fnmatch(base, "docker-compose*.yml")
                or fnmatch.fnmatch(base, "docker-compose*.yaml") or base.endswith(".ksh")):
            return True
    for f in files:
        base = _base(f)
        if base.endswith(".sh") or base == "Makefile":
            if "cron" in read_text(os.path.join(root, f), 1 << 20):
                return True
    return False


def detect_description(root):
    text = read_text(os.path.join(root, "README.md"))
    for para in re.split(r"\n\s*\n", text):
        para = " ".join(para.split())
        if not para or para.startswith(("#", "!", "<", "[![", "```", "---", "===")):
            continue
        first = re.split(r"(?<=[.!?])\s", para, maxsplit=1)[0]
        return first[:200].strip()
    return ""


def detect(root):
    files, dirs = scan_project(root)
    return {
        "name": os.path.basename(os.path.abspath(root)),
        "description": detect_description(root),
        "kind": detect_kind(root, files, dirs),
        "languages": detect_languages(files),
        "test_command": detect_test_command(root, files),
        "production": detect_production(root, files),
        "docs": detect_docs(files),
    }


