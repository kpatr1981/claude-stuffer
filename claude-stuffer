def today():
    return datetime.date.today().isoformat()


def marker_line():
    return ("<!-- generated by claude-stuffer on %s. Edit freely; re-running overwrites "
            "this file only with --force. -->" % today())


def read_text(path, limit=None):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read(limit) if limit else fh.read()
    except OSError:
        return ""


def write_text(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)


MARKER_PREFIX = "<!-- generated by claude-stuffer on "


def is_ours(path):
    """Ours only if the first body line after the frontmatter is our marker. Never a symlink."""
    if os.path.islink(path):
        return False
    text = read_text(path)
    m = re.match(r"---\n.*?\n---\n", text, re.S)
    body = text[m.end():] if m else text
    return body.startswith(MARKER_PREFIX)


def role_title(name):
    return name.replace("-", " ")


def sentence(text):
    """One line, no trailing period (callers add it)."""
    return " ".join(str(text).split()).rstrip(".")


def capitalized(text):
    return text[:1].upper() + text[1:]


def stuffer_home():
    return os.environ.get("CLAUDE_STUFFER_HOME") or os.path.expanduser("~")


def split_list(value, field="list"):
    """None, a comma-separated string, or a list of strings; anything else is bad input."""
    if value is None:
        return []
    if isinstance(value, str):
        value = value.split(",")
    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
        raise UsageError("%s must be a list of strings or a single string, not %s"
                         % (field, json.dumps(value)))
    return [v.strip() for v in value if v.strip()]


def str_field(value, field):
    if value is not None and not isinstance(value, str):
        raise UsageError("%s must be a string, not %s" % (field, json.dumps(value)))
    return value


