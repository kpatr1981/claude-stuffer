# Main
# --------------------------------------------------------------------------

def add_common(parser, suppress):
    default = {"default": argparse.SUPPRESS} if suppress else {}
    parser.add_argument("--dry-run", action="store_true", help="print every file that would be written, write nothing", **default)
    parser.add_argument("--answers", metavar="FILE.json", help="non-interactive: take answers from FILE", **default)
    parser.add_argument("--project", metavar="DIR", help="use DIR instead of the current folder", **default)
    parser.add_argument("--force", action="store_true", help="overwrite agent files this tool generated earlier", **default)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="claude-stuffer",
        description="Staff a Claude Code project with a team of subagents (team by seniority). "
                    "With no command: interview in the project folder, then write the team.",
        epilog="Exit codes: 0 ok, 1 user abort or nothing to do, 2 bad usage or error.")
    parser.add_argument("--version", action="version", version="claude-stuffer " + VERSION)
    parser.add_argument("--kinds", action="store_true", help="list project kinds and the roles each proposes")
    add_common(parser, suppress=False)
    sub = parser.add_subparsers(dest="command", metavar="{init,show}")
    p_init = sub.add_parser("init", help="install or update the global bench in ~/.claude")
    add_common(p_init, suppress=True)
    p_show = sub.add_parser("show", help="print the project's current team")
    add_common(p_show, suppress=True)
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        if args.kinds:
            return print_kinds()
        if args.command == "init":
            return cmd_init(args)
        if args.command == "show":
            return cmd_show(args)
        return cmd_staff(args)
    except UsageError as exc:
        sys.stderr.write("claude-stuffer: error: %s\n" % exc)
        return EXIT_USAGE
    except Abort as exc:
        sys.stderr.write("claude-stuffer: %s\n" % exc)
        return EXIT_ABORT
    except KeyboardInterrupt:
        sys.stderr.write("\nclaude-stuffer: aborted, nothing written\n")
        return EXIT_ABORT
    except OSError as exc:
        sys.stderr.write("claude-stuffer: error: %s\n" % exc)
        return EXIT_USAGE


if __name__ == "__main__":
    sys.exit(main())
