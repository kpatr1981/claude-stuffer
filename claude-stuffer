    name, level = role["name"], role["level"]
    model = LEVEL_MODEL[level]
    title = role_title(name)
    head = ["---", "name: " + name,
            "description: %s for %s (%s, %s; level set per task by the architect). %s." % (
                capitalized(title), plan["name"], level, model, capitalized(sentence(role["line"]))),
            "model: " + model]
    if role.get("tools"):
        head.append("tools: " + role["tools"])
    head.append("---")

    knows = role.get("knows") or []
    read_first = list(plan["docs"])
    read_first += [k for k in knows if is_path_like(k) and k not in read_first]
    notes = [k for k in knows if not is_path_like(k)]

    body = [marker_line(),
            "You are the %s for %s: %s." % (title, plan["name"], sentence(plan["description"]))]
    if read_first:
        body.append("Read first: %s." % ", ".join(read_first))
    if notes:
        body.append("Know: %s." % "; ".join(sentence(n) for n in notes))
    if plan["languages"]:
        body.append("Stack: %s." % ", ".join(plan["languages"]))
    if plan["test_command"]:
        body.append("Tests: run `%s` after every change." % plan["test_command"])
    else:
        body.append(NO_TESTS_LINE)
    if plan["production"]:
        body.append(PRODUCTION_LINE)
    if role.get("rules"):
        body.append("Rules:")
        body += ["- " + r for r in role["rules"]]
    if role.get("tools"):
        body += [READ_ONLY_FAILURE, READ_ONLY_REPORT]
    else:
        body += [FAILURE_PARAGRAPH, REPORT_LINE]
    return "\n".join(head + body) + "\n"


def render_team_block(plan):
    lines = ["## Team (staffed %s by claude-stuffer)" % today(), "",
             "Global bench applies (`senior`, `mid`, `junior`, `reviewer`, `qa`, `scout`). "
             "Project roles, level chosen per task by the architect:", ""]
    for role in plan["roles"]:
        lines.append("- `%s` (%s; %s): %s." % (
            role["name"], LEVEL_MODEL[role["level"]].capitalize(), role["level"],
            capitalized(sentence(role["line"]))))
    if not plan["test_command"]:
        lines.append("- No test suite: code changes go to the most senior role that fits, "
                     "and every spec says how to verify.")
    if plan["production"]:
        lines.append("- Production: changes are specified, backed up and verified one at a time; "
                     "the user applies anything the spec marks as manual.")
    return "\n".join(lines)


def upsert_block(text, start, end, body):
    """Replace the block between start/end markers in place, or append it."""
    block = "%s\n%s\n%s" % (start, body.strip("\n"), end)
    i = text.find(start)
    j = text.find(end, i + len(start)) if i >= 0 else -1
    if i >= 0 and j >= 0:
        return text[:i] + block + text[j + len(end):]
    if i >= 0 or end in text:
        raise UsageError("unbalanced claude-stuffer markers in CLAUDE.md (%s ... %s); fix it by hand"
                         % (start, end))
    if text and not text.endswith("\n"):
        text += "\n"
    return text + ("\n" if text else "") + block + "\n"


def bench_text(name):
    """A bench agent with the generated-by marker as the first body line."""
    m = re.match(r"(---\n.*?\n---\n)(.*)", BENCH[name], re.S)
    return m.group(1) + marker_line() + "\n" + m.group(2)


# --------------------------------------------------------------------------
# File actions (shared by init and staffing)
# --------------------------------------------------------------------------

def plan_file(path, content, force):
    """Decide what to do with one generated file: write, rewrite, keep or not-ours."""
    if os.path.islink(path):
        return (path, "not ours", None)  # never write through a link, dangling or not
    if not os.path.exists(path):
        return (path, "write", content)
    if not is_ours(path):
        return (path, "not ours", None)
    if force:
        return (path, "rewrite", content)
    return (path, "keep", None)


DONE_LABEL = {"write": "wrote", "rewrite": "rewrote", "keep": "kept", "not ours": "not ours",
              "update": "updated"}


def display_path(path):
    """Paths under the current folder print relative; under the home folder as ~/..."""
    cwd, home = os.getcwd(), stuffer_home()
    if path.startswith(cwd + os.sep):
        return os.path.relpath(path, cwd)
    if path.startswith(home.rstrip(os.sep) + os.sep):
        return "~/" + os.path.relpath(path, home)
    return path


def describe(actions, dry_run):
    out = []
    for path, action, _ in actions:
        if dry_run and action in ("write", "rewrite", "update"):
            label = "would " + action
        else:
            label = DONE_LABEL[action]
        note = ""
        if action == "keep":
            note = "  (exists; --force rewrites it)"
        elif action == "not ours":
            note = "  (no claude-stuffer marker; left alone)"
        out.append("  %-12s %s%s" % (label, display_path(path), note))
    return "\n".join(out)


def apply(actions):
    for path, action, content in actions:
        if content is not None and action in ("write", "rewrite", "update"):
            write_text(path, content)


def claude_md_action(path, heading, start, end, body):
    if os.path.islink(path) and not os.path.exists(path):
        raise UsageError("%s is a broken symlink; fix or remove it first" % path)
    text = read_text(path) if os.path.exists(path) else heading + "\n"
    return (path, "update", upsert_block(text, start, end, body))


