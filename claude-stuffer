def scan_project(root):
    """Return (files, dirs) as relative posix paths, skipping ignored folders."""
    files, dirs = [], []
    for here, subdirs, names in os.walk(root):
        subdirs[:] = sorted(d for d in subdirs if d not in IGNORED_DIRS)
        rel = os.path.relpath(here, root)
        rel = "" if rel == "." else rel.replace(os.sep, "/") + "/"
        dirs.extend(rel + d for d in subdirs)
        files.extend(rel + n for n in sorted(names))
        if len(files) > MAX_FILES:
            break
    return files, dirs


def _base(path):
    return path.rsplit("/", 1)[-1]


def _any(files, *patterns):
    return any(fnmatch.fnmatch(_base(f), p) for f in files for p in patterns)


def _load_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


